{
  "multipart": [
    {
      "apply": {
        "model": "zitraksmode:block/salt_redstone_dot_white"
      },
      "when": {
        "OR": [
          {
            "east": "none",
            "north": "none",
            "south": "none",
            "west": "none"
          },
          {
            "east": "side|up",
            "north": "side|up"
          },
          {
            "east": "side|up",
            "south": "side|up"
          },
          {
            "south": "side|up",
            "west": "side|up"
          },
          {
            "north": "side|up",
            "west": "side|up"
          }
        ]
      }
    },
    {
      "apply": {
        "model": "zitraksmode:block/salt_redstone_side0_white"
      },
      "when": {
        "north": "side|up"
      }
    },
    {
      "apply": {
        "model": "zitraksmode:block/salt_redstone_side_alt0_white"
      },
      "when": {
        "south": "side|up"
      }
    },
    {
      "apply": {
        "model": "zitraksmode:block/salt_redstone_side_alt1_white",
        "y": 270
      },
      "when": {
        "east": "side|up"
      }
    },
    {
      "apply": {
        "model": "zitraksmode:block/salt_redstone_side1_white",
        "y": 270
      },
      "when": {
        "west": "side|up"
      }
    },
    {
      "apply": {
        "model": "zitraksmode:block/salt_redstone_up_white"
      },
      "when": {
        "north": "up"
      }
    },
    {
      "apply": {
        "model": "zitraksmode:block/salt_redstone_up_white",
        "y": 90
      },
      "when": {
        "east": "up"
      }
    },
    {
      "apply": {
        "model": "zitraksmode:block/salt_redstone_up_white",
        "y": 180
      },
      "when": {
        "south": "up"
      }
    },
    {
      "apply": {
        "model": "zitraksmode:block/salt_redstone_up_white",
        "y": 270
      },
      "when": {
        "west": "up"
      }
    }
  ]
}
